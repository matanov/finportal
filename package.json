{
  "name": "finportal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate:pay": "node scripts/build-pay-lookup.mjs",
    "generate:tsp": "node scripts/build-tsp-lookup.mjs",
    "fetch:tsp": "node scripts/fetch-tsp-prices.mjs",
    "fetch:tsp:historical": "node scripts/fetch-tsp-historical-returns.mjs",
    "consolidate:feedback": "node scripts/consolidate-feedback.mjs",
    "test:tsp": "node --experimental-strip-types --no-warnings scripts/test-tsp-contributions.mts",
    "test:fers-annuity": "node --experimental-strip-types --no-warnings scripts/test-fers-annuity.mts",
    "prebuild": "node scripts/build-pay-lookup.mjs && node scripts/build-tsp-lookup.mjs",
    "predev": "node scripts/build-pay-lookup.mjs && node scripts/build-tsp-lookup.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
