---
/**
 * ArticleLayout.astro
 *
 * Page chrome for every article in the `articles` collection: meta tags,
 * breadcrumb, title and byline, and the typography for the Markdown body.
 * Articles themselves carry no styling, so a new .mdx file looks like the
 * rest of the blog automatically.
 */
import Layout from './Layout.astro';
import { articleUrl, formatPublished, isoDate, readMinutes, type Article } from '../lib/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, category, published, draft, unlisted } = article.data;
const canonical = new URL(articleUrl(article), Astro.site).href;
// Drafts and unlisted previews are both kept out of search and labelled on the page
const badge = draft
  ? 'Draft — visible in dev only'
  : unlisted
    ? 'Unlisted — not linked from the site'
    : null;
---

<Layout title={`${title} | FersMath`} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="article:published_time" content={isoDate(published)} />
    {badge && <meta name="robots" content="noindex, nofollow" />}
  </Fragment>

  <main style="min-height: 100vh; background: #f8fafc; padding: 2rem 1rem;">
    <div style="max-width: 760px; margin: 0 auto;">

      <!-- Breadcrumb -->
      <nav style="margin-bottom: 1.5rem; font-size: 0.875rem; color: #64748b;">
        <a href="/" style="color: #2A7D9C; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem;">›</span>
        <a href="/blog" style="color: #2A7D9C; text-decoration: none;">Articles</a>
        <span style="margin: 0 0.5rem;">›</span>
        <span>{title}</span>
      </nav>

      {badge && (
        <div
          style="display: inline-block; background: #fffbeb; border: 1px solid #fde68a; color: #92400e;
                 font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;
                 padding: 0.3rem 0.75rem; border-radius: 999px; margin-bottom: 1.25rem;"
        >
          {badge}
        </div>
      )}

      <article
        style="background: #fff; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 2rem 2.25rem;
               box-shadow: 0 1px 2px rgba(15, 34, 68, 0.04);"
      >
        <h1
          style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.75rem, 4vw, 2.25rem);
                 font-weight: 700; color: #0F2244; line-height: 1.25; margin: 0 0 0.75rem;"
        >
          {title}
        </h1>
        <p style="font-size: 0.85rem; color: #64748b; margin: 0 0 1.75rem;">
          <span style="color: #C9A035; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem;">
            {category}
          </span>
          <span style="margin: 0 0.5rem;">·</span>
          <time datetime={isoDate(published)}>{formatPublished(published, 'long')}</time>
          <span style="margin: 0 0.5rem;">·</span>
          {readMinutes(article)} min read
        </p>

        <div class="article-body">
          <slot />
        </div>
      </article>

    </div>
  </main>
</Layout>

<style>
  /* The body is rendered Markdown from another file, so these rules use
     :global() to reach it. They only apply inside .article-body. */
  .article-body {
    font-size: 1rem;
    color: #334155;
    line-height: 1.75;
  }

  .article-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #0f2244;
    line-height: 1.3;
    margin: 2.25rem 0 0.75rem;
  }
  .article-body :global(h2) {
    font-size: 1.5rem;
  }
  .article-body :global(h3) {
    font-size: 1.2rem;
  }

  .article-body :global(a) {
    color: #2a7d9c;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }
  .article-body :global(ul) {
    list-style: disc;
  }
  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(blockquote) {
    margin: 0 0 1.25rem;
    padding-left: 1rem;
    border-left: 3px solid #c9a035;
    color: #475569;
  }

  /* `---` in Markdown: a short gold rule as a section break */
  .article-body :global(hr) {
    width: 4rem;
    margin: 3rem auto;
    border: 0;
    border-top: 3px solid #c9a035;
    border-radius: 2px;
  }

  /* Markdown tables */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .article-body > :global(table) {
    margin: 0 0 1.25rem;
  }
  .article-body :global(th) {
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid #cbd5e1;
    text-align: left;
    color: #0f2244;
    font-weight: 600;
  }
  .article-body :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
  }
  .article-body :global(th[align='right']),
  .article-body :global(td[align='right']) {
    text-align: right;
  }
  .article-body :global(th[align='center']),
  .article-body :global(td[align='center']) {
    text-align: center;
  }
  .article-body :global(sup) {
    color: #2a7d9c;
  }

  /* Markdown footnotes ([^name]) collect at the end of the article */
  .article-body :global(.footnotes) {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.6;
  }
  .article-body :global(.footnotes h2) {
    font-size: 1rem;
    margin-top: 0;
  }
</style>
