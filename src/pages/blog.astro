---
import Layout from '../layouts/Layout.astro';
import { ARTICLES, articleUrl, formatPublished } from '../data/articles';
---

<Layout
  title="Articles | FersMath"
  description="Clear, unbiased writing on federal pay, FERS, TSP, and Social Security — with interactive charts built on real OPM and SSA data."
>
  <main style="min-height: 100vh; background: #f8fafc; padding: 2rem 1rem;">
    <div style="max-width: 760px; margin: 0 auto;">

      <!-- Breadcrumb -->
      <nav style="margin-bottom: 1.5rem; font-size: 0.875rem; color: #64748b;">
        <a href="/" style="color: #2A7D9C; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem;">›</span>
        <span>Articles</span>
      </nav>

      <h1
        style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.75rem, 4vw, 2.25rem);
               font-weight: 700; color: #0F2244; line-height: 1.25; margin: 0 0 0.5rem;"
      >
        Articles
      </h1>
      <p style="font-size: 1rem; color: #64748b; line-height: 1.6; margin: 0 0 2rem;">
        Clear, unbiased financial writing — no ads, no sponsored content.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        {ARTICLES.map((article) => (
          <a
            href={articleUrl(article)}
            style="display: block; background: #fff; border: 1px solid #e2e8f0; border-radius: 0.75rem;
                   padding: 1.5rem 1.75rem; text-decoration: none; box-shadow: 0 1px 2px rgba(15, 34, 68, 0.04);"
          >
            <span
              style="font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #C9A035;"
            >
              {article.category}
            </span>
            <h2
              style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.35rem; font-weight: 700;
                     color: #0F2244; line-height: 1.3; margin: 0.4rem 0 0.6rem;"
            >
              {article.title}
            </h2>
            <p style="font-size: 0.925rem; color: #475569; line-height: 1.6; margin: 0 0 1rem;">
              {article.description}
            </p>
            <div style="font-size: 0.8rem; color: #94a3b8;">
              <time datetime={article.published}>{formatPublished(article.published, 'long')}</time>
              <span style="margin: 0 0.5rem;">·</span>
              {article.readMinutes} min read
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>
</Layout>
