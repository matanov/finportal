---
/**
 * One page per article in src/content/articles/. The file name is the slug:
 * federal-compensation-vs-social-security-wage-maximum.mdx is served at
 * /blog/federal-compensation-vs-social-security-wage-maximum/.
 */
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticles, type Article } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { Content } = await render(article);
---

<ArticleLayout article={article}>
  <Content />
</ArticleLayout>
