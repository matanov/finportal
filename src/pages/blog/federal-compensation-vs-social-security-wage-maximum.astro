                  <tr><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: left;">2020</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">$137,700</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">+$4,800</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">+3.61%</td></tr>
