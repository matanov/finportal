                  <tr><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: left;">2014</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">$117,000</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">+$3,300</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">+2.90%</td></tr>
                  <tr><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: left;">2015</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">$118,500</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">+$1,500</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">+1.28%</td></tr>
                  <tr><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: left;">2016</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">$118,500</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">$0</td><td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; text-align: right;">0.00%<sup><a href="#fn-1" id="fnref-1" style="color: #2A7D9C; text-decoration: none;">[1]</a></sup></td></tr>
