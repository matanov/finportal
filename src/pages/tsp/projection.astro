---
import Layout from '../../layouts/Layout.astro';
import TspProjection from '../../components/TspProjection';
---

<Layout
  title="TSP Projection Calculator | FersMath"
  description="Project your Thrift Savings Plan balance from your current fund balances, Roth and Traditional, and your future contribution allocation."
>
  <main style="min-height: 100vh; background: #f8fafc; padding: 2rem 1rem;">
    <div style="max-width: 980px; margin: 0 auto;">

      <!-- Breadcrumb -->
      <nav style="margin-bottom: 1.5rem; font-size: 0.875rem; color: #64748b;">
        <a href="/" style="color: #2A7D9C; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem;">›</span>
        <span>TSP Projection Calculator</span>
      </nav>

      <!-- React component — client:load so it hydrates immediately -->
      <TspProjection client:load />

    </div>
  </main>
</Layout>
